rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function teacher() {
      return signedIn() && exists(/databases/$(database)/documents/teachers/$(request.auth.uid))
        && get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.enabled == true;
    }
    function identityScope(classId) {
      let token=request.auth.token;
      let email=token.get('email','');
      let guest=token.get('guest',false) == true;
      let guestEmail=email == 'guest-teacher@teachers.donghyun-hackthon.invalid'
        || email.matches('s-2-12-([1-9]|1[0-9]|2[0-8])@students[.]donghyun-hackthon[.]invalid');
      return (!guest && !guestEmail)
        || (classId == '2-12' && (!guest || token.get('classroom','') == '2-12'));
    }
    function teacherRoleScope(role,classId) {
      return (role.get('guest',false) == false && !role.keys().hasAny(['classIds']))
        || (role.get('classIds',[]) is list && classId in role.get('classIds',[])
          && (role.get('guest',false) == false || (role.get('guest',false) == true && classId == '2-12')));
    }
    function teacherForClass(classId) {
      return teacher() && identityScope(classId)
        && teacherRoleScope(get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data,classId);
    }
    function classroomReader(classId) {
      return signedIn() && identityScope(classId)
        && (!exists(/databases/$(database)/documents/teachers/$(request.auth.uid)) || teacherForClass(classId));
    }
    function studentIdentity(classId, num) {
      let key=num < 10 ? '0'+string(num) : string(num);
      let profile=/databases/$(database)/documents/learning_classes/$(classId)/students/$(key);
      return signedIn() && identityScope(classId) && exists(profile) && get(profile).data.enabled == true
        && get(profile).data.uid == request.auth.uid;
    }
    match /learning_classes/{classId} {
      allow read: if teacherForClass(classId);
      allow write: if false;
      match /students/{studentNum} {
      allow get: if teacherForClass(classId) || (signedIn() && identityScope(classId) && resource.data.uid == request.auth.uid);
      allow list: if teacherForClass(classId);
      allow create, update: if teacherForClass(classId)
        && request.resource.data.keys().hasOnly(['uid','classId','studentNum','name','enabled'])
        && request.resource.data.uid is string && request.resource.data.uid.size() > 0 && request.resource.data.uid.size() <= 128
        && request.resource.data.classId == classId && request.resource.data.studentNum == int(studentNum)
        && studentNum.matches('(0[1-9]|1[0-9]|2[0-8])')
        && request.resource.data.classId.matches('2-([1-9]|10|11|12)')
        && request.resource.data.studentNum is int && request.resource.data.studentNum >= 1 && request.resource.data.studentNum <= 28
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.enabled is bool;
      allow delete: if false;
      match /submissions/{submissionId} {
        function own() { return studentIdentity(classId,int(studentNum)); }
        function answer(a, id) {
          return a is map && a.keys().hasOnly(['questionId','choiceIndex']) && a.questionId == id
            && (a.choiceIndex == null || (a.choiceIndex is int && a.choiceIndex >= 0 && a.choiceIndex < 4));
        }
        function validSnapshot() {
          let d=request.resource.data;
          let p=d.practice;
          return d.keys().hasOnly(['schemaVersion','unitKey','activityId','contentVersion','quiz','practice','ownerUid','classId','studentNum','submittedAt'])
            && d.schemaVersion == 1 && d.unitKey == 'abstraction' && d.activityId == 'abstraction-core' && d.contentVersion == 'abstraction-v1'
            && d.ownerUid == request.auth.uid && d.classId == classId && d.studentNum == int(studentNum) && own() && d.submittedAt == request.time
            && d.quiz.keys().hasOnly(['answers']) && d.quiz.answers is list && d.quiz.answers.size() == 4
            && answer(d.quiz.answers[0],1) && answer(d.quiz.answers[1],2) && answer(d.quiz.answers[2],3) && answer(d.quiz.answers[3],4)
            && p.keys().hasOnly(['currentState','goalState','conditions','conditionDraft','keptInformation','discardedInformation'])
            && p.currentState is string && p.currentState.size() <= 4000 && p.goalState is string && p.goalState.size() <= 4000
            && p.conditionDraft is string && p.conditionDraft.size() <= 2000
            && p.conditions is list && p.conditions.size() <= 50
            && p.keptInformation is list && p.keptInformation.size() <= 50
            && p.discardedInformation is list && p.discardedInformation.size() <= 50;
        }
        allow read: if teacherForClass(classId) || own();
        function validActivitySnapshot() {
          let d=request.resource.data;
          return d.keys().hasOnly(['schemaVersion','unitKey','activityKind','activityId','contentVersion','quiz','practice','ownerUid','classId','studentNum','submittedAt'])
            && d.schemaVersion == 2 && d.unitKey in ['abstraction','algorithm','flowchart']
            && d.activityKind in ['quiz','practice'] && d.activityId == d.unitKey+'-'+d.activityKind && d.contentVersion == d.unitKey+'-v1'
            && d.ownerUid == request.auth.uid && d.classId == classId && d.studentNum == int(studentNum) && d.submittedAt == request.time
            && ((d.activityKind == 'quiz' && d.practice == null
                 && d.quiz is map && d.quiz.keys().hasOnly(['answers']) && d.quiz.answers is list && d.quiz.answers.size() == 4
                 && answer(d.quiz.answers[0],1) && answer(d.quiz.answers[1],2) && answer(d.quiz.answers[2],3) && answer(d.quiz.answers[3],4))
                || (d.activityKind == 'practice' && d.quiz == null && d.practice is map && d.practice.keys().hasOnly(['stage','contentJson'])
                    && d.practice.contentJson is string && d.practice.contentJson.size() <= 100000
                    && ((d.unitKey == 'abstraction' && d.practice.stage in ['tutorial','workspace'])
                        || (d.unitKey == 'algorithm' && d.practice.stage == 'sandwich')
                        || (d.unitKey == 'flowchart' && d.practice.stage in ['step-1','step-2','step-3','step-4','step-5']))));
        }
        allow create: if own() && submissionId.size() == 36 && (validSnapshot() || validActivitySnapshot());
        allow update, delete: if false;
      }
      }
    }
    // Only the project administrator can provision roles using the console/Admin API.
    match /teachers/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }
    // Monotonic daily counter shared by every server instance. Clients cannot reset it.
    match /ai_usage/{day} {
      function today() { return day == string(int(request.time.toMillis() / 86400000)); }
      allow get: if signedIn();
      allow create: if signedIn() && today() && request.resource.data.keys().hasOnly(['count']) && request.resource.data.count == 1;
      allow update: if signedIn() && today() && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1 && request.resource.data.count <= 1000;
      allow list, delete: if false;
    }
    match /classrooms/{classId} {
      function active() {
        let session = get(/databases/$(database)/documents/classrooms/$(classId)).data;
        return session.status == 'in_progress' && request.time.toMillis() < session.deadlineMs;
      }
      allow get: if classroomReader(classId);
      allow list: if teacherForClass(classId);
      allow create, update: if teacherForClass(classId) && classId.matches('2-([1-9]|10|11|12)')
        && request.resource.data.classId == classId
        && request.resource.data.status in ['waiting', 'in_progress', 'ended'];
      allow delete: if false;
      match /archives/{archiveId} {
        allow read, create: if teacherForClass(classId);
        allow update, delete: if false;
        match /students/{studentNum} {
          allow read, create: if teacherForClass(classId);
          allow update, delete: if false;
        }
      }
      match /students/{studentNum} {
        function owner() { return studentIdentity(classId,int(studentNum)) && resource.data.ownerUid == request.auth.uid; }
        function validAnswers() {
          return request.resource.data.answers is map
            && request.resource.data.answers.keys().hasOnly(['part1', 'part2', 'part3'])
            && request.resource.data.answers.part1 is map
            && request.resource.data.answers.part2 is map;
        }
        function validProgress() {
          return request.resource.data.progress is map
            && request.resource.data.progress.part1 is int && request.resource.data.progress.part1 >= 0 && request.resource.data.progress.part1 <= 10
            && request.resource.data.progress.part2 is int && request.resource.data.progress.part2 >= 0 && request.resource.data.progress.part2 <= 6
            && request.resource.data.progress.part3 is int && request.resource.data.progress.part3 >= 0 && request.resource.data.progress.part3 <= 1;
        }
        // A missing document can be read to reserve a seat in a transaction.
        allow get: if teacherForClass(classId) || (studentIdentity(classId,int(studentNum)) && (!exists(/databases/$(database)/documents/classrooms/$(classId)/students/$(studentNum)) || owner()));
        allow list: if teacherForClass(classId);
        allow create: if studentIdentity(classId,int(studentNum)) && classId.matches('2-([1-9]|10|11|12)')
          && studentNum.matches('(0[1-9]|1[0-9]|2[0-8])')
          && request.resource.data.keys().hasOnly(['num','numStr','name','ownerUid','status','joinedAt','submittedAt','progress','answers','feedback','attemptId'])
          && get(/databases/$(database)/documents/classrooms/$(classId)).data.status in ['waiting','in_progress']
          && request.resource.data.attemptId == get(/databases/$(database)/documents/classrooms/$(classId)).data.attemptId
          && request.resource.data.num == int(studentNum)
          && request.resource.data.numStr == studentNum
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
          && request.resource.data.status == 'waiting' && validAnswers() && validProgress();
        allow update: if teacherForClass(classId) || (owner() && resource.data.status != 'submitted'
          && validAnswers() && validProgress()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','answers','progress','updatedAt','submittedAt'])
          && ((active() && request.resource.data.status in ['in_progress','submitted'])
            || (request.resource.data.status == 'submitted' && request.resource.data.answers == resource.data.answers)));
        allow delete: if teacherForClass(classId) && getAfter(/databases/$(database)/documents/classrooms/$(classId)).data.status == 'waiting';
      }
    }
  }
}
